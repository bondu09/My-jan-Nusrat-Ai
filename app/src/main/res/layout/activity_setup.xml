<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootSetupLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_back"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NUSRAT AI সেটআপ"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মাল্টি-প্রোভাইডার AI API Key ও নিয়মাবলী কনফিগারেশন"
                android:textColor="?attr/themeTextMuted"
                android:textSize="12sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Hero Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="স্বাগতম NUSRAT AI তে"
                        android:textColor="?attr/themeAccent"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="আপনার আধুনিক AI ও ভয়েস ইন্টেলিজেন্স সহকারী"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="অ্যাপটি সম্পূর্ণ সক্রিয় করতে প্রথমে ব্যবহারের সম্মতি নিশ্চিত করুন এবং প্রয়োজনীয় AI API কী যুক্ত করুন। নিচে ৩টি শক্তিশালী AI প্রোভাইডারের তথ্য দেওয়া হয়েছে।"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. BENGALI AGREEMENT SYSTEM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="১. ব্যবহারের নিয়মাবলী ও সম্মতিপত্র (AGREEMENT TERMS)"
                android:textColor="?attr/themeAccent"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NUSRAT AI ব্যবহারের নীতিমালা ও ডাটা সুরক্ষা:"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="• ১. সহকারী ফাংশন: NUSRAT AI আপনার কণ্ঠস্বর শুনে ডিভাইস কন্ট্রোল, অ্যাপ লঞ্চ, গান ও মেসেজিং সুবিধা দিতে সক্ষম।\n\n• ২. গোপনীয়তা নীতি: আপনার ব্যক্তিগত ভয়েস বা মেসেজ কখনোই অননুমোদিত কারো সাথে শেয়ার করা হয় না। সকল রিকগনিশন সুরক্ষিত TLS এনক্রিপশনের মাধ্যমে পরিচালিত।\n\n• ৩. ব্যাকগ্রাউন্ড ভয়েস রিকগনিশন: 'নুসরাত' নামে ডাকলে ব্যাকগ্রাউন্ড থেকে জেগে ওঠার জন্য ডিভাইস মাইক্রোফোন ও নোটিফিকেশন অনুমতির প্রয়োজন।\n\n• ৪. দায়মুক্তি ও শর্ত: ইউজার নিজ দায়িত্বে API Key পরিচালনা করবেন এবং কোনো অপব্যবহার করা যাবে না।\n\n• ৫. সিস্টেম ডেভেলপমেন্ট: NUSRAT AI সম্পূর্ণভাবে MD APON কর্তৃক ইঞ্জিনিয়ার্ড ও ডেভেলপকৃত।"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12.5sp"
                        android:lineSpacingExtra="3dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="10dp"
                        android:background="?attr/themeCardBorder" />

                    <CheckBox
                        android:id="@+id/cbAgreement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="আমি NUSRAT AI এর সকল শর্তাবলী ও নিয়মনীতি পড়েছি এবং পূর্ণ সম্মতি দিচ্ছি।"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:buttonTint="?attr/themeAccent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. AI APIS DETAILS & SETUP HEADER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="২. এআই এপিআই-এর ডিটেইলস ও সেটআপ"
                android:textColor="?attr/themeAccent"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- API 1: Google Gemini API -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="১. Google Gemini API (আবশ্যক - লাইভ ভয়েস)"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRIMARY"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_jarvis_status_badge_green"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp" />
                    </LinearLayout>

                    <!-- Exact Bengali description & link required by user -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• কাজ: এটি একটি শক্তিশালী মডেল যা টেক্সট, ছবি এবং কোড বুঝতে পারে।"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="• লিংক: https://aistudio.google.com/"
                        android:textColor="?attr/themeAccent"
                        android:textSize="12sp" />

                    <!-- Live Status Badge Card -->
                    <LinearLayout
                        android:id="@+id/layoutLiveBadge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_jarvis_row_item"
                        android:padding="12dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp">

                        <View
                            android:id="@+id/viewLiveDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/circle_cyan"
                            android:backgroundTint="#EAB308" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:id="@+id/tvLiveStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="অপেক্ষমান • Gemini API Key দিন"
                                android:textColor="?attr/themeTextPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPingSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="কী যুক্ত করে টেস্ট করুন"
                                android:textColor="?attr/themeTextMuted"
                                android:textSize="11.5sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="?attr/themeAccent"
                        app:hintTextColor="?attr/themeAccent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Gemini API Key (AIzaSy...)"
                            android:inputType="textPassword"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="13.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnPasteKey"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="পেস্ট"
                            android:textSize="12sp"
                            android:textColor="?attr/themeAccent"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnClearKey"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="মুছুন"
                            android:textSize="12sp"
                            android:textColor="?attr/themeTextMuted" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnTestKey"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="?attr/themeAccent"
                        android:text="Gemini Key টেস্ট ও লাইভ ভেরিফাই করুন"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnGetApiKeyLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center"
                        android:text="Google AI Studio থেকে ফ্রি কী নিন (https://aistudio.google.com/) ↗"
                        android:textColor="?attr/themeAccent"
                        android:textSize="11.5sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- API 2: OpenAI API (ChatGPT) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="২. OpenAI API (ChatGPT)"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OPTIONAL"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="?attr/themeTextMuted"
                            android:background="@drawable/bg_jarvis_status_badge"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp" />
                    </LinearLayout>

                    <!-- Exact Bengali description & link required by user -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• কাজ: এটি চ্যাট, কোড জেনারেশন এবং অন্যান্য টেক্সট-ভিত্তিক কাজের জন্য দারুণ সাহায্য করে।"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="• লিংক: https://platform.openai.com/"
                        android:textColor="?attr/themeAccent"
                        android:textSize="12sp" />

                    <!-- Live Status Badge Card -->
                    <LinearLayout
                        android:id="@+id/layoutOpenAiBadge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_jarvis_row_item"
                        android:padding="12dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp">

                        <View
                            android:id="@+id/viewOpenAiDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/circle_cyan"
                            android:backgroundTint="#94A3B8" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:id="@+id/tvOpenAiStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ঐচ্ছিক • OpenAI Key দিন (sk-...)"
                                android:textColor="?attr/themeTextPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOpenAiPingSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="চ্যাট ও কোডিং সহায়তার জন্য যুক্ত করতে পারেন"
                                android:textColor="?attr/themeTextMuted"
                                android:textSize="11.5sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="?attr/themeAccent"
                        app:hintTextColor="?attr/themeAccent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOpenAiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="OpenAI API Key (sk-proj-...)"
                            android:inputType="textPassword"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="13.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnPasteOpenAiKey"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="পেস্ট"
                            android:textSize="12sp"
                            android:textColor="?attr/themeAccent"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnClearOpenAiKey"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="মুছুন"
                            android:textSize="12sp"
                            android:textColor="?attr/themeTextMuted" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnTestOpenAiKey"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        app:strokeColor="?attr/themeAccent"
                        android:text="OpenAI Key ভেরিফাই করুন"
                        android:textColor="?attr/themeAccent"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnGetOpenAiLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center"
                        android:text="OpenAI Platform থেকে কী সংগ্রহ করুন (https://platform.openai.com/) ↗"
                        android:textColor="?attr/themeAccent"
                        android:textSize="11.5sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- API 3: ElevenLabs API -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="৩. ElevenLabs API (ন্যাচারাল ভয়েস)"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OPTIONAL"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="?attr/themeTextMuted"
                            android:background="@drawable/bg_jarvis_status_badge"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp" />
                    </LinearLayout>

                    <!-- Exact Bengali description & link required by user -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• কাজ: এটি মানুষের মতো ভয়েস তৈরি করতে সাহায্য করে।"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="• লিংক: https://elevenlabs.io/"
                        android:textColor="?attr/themeAccent"
                        android:textSize="12sp" />

                    <!-- Live Status Badge Card -->
                    <LinearLayout
                        android:id="@+id/layoutElevenLabsBadge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_jarvis_row_item"
                        android:padding="12dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp">

                        <View
                            android:id="@+id/viewElevenLabsDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/circle_cyan"
                            android:backgroundTint="#94A3B8" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:id="@+id/tvElevenLabsStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ঐচ্ছিক • ElevenLabs API Key দিন"
                                android:textColor="?attr/themeTextPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvElevenLabsPingSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="মানুষের মতো প্রাকৃতিক কণ্ঠের জন্য যুক্ত করতে পারেন"
                                android:textColor="?attr/themeTextMuted"
                                android:textSize="11.5sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="?attr/themeAccent"
                        app:hintTextColor="?attr/themeAccent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etElevenLabsKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="ElevenLabs API Key"
                            android:inputType="textPassword"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="13.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnPasteElevenLabsKey"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="পেস্ট"
                            android:textSize="12sp"
                            android:textColor="?attr/themeAccent"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnClearElevenLabsKey"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="মুছুন"
                            android:textSize="12sp"
                            android:textColor="?attr/themeTextMuted" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnTestElevenLabsKey"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        app:strokeColor="?attr/themeAccent"
                        android:text="ElevenLabs Key ভেরিফাই করুন"
                        android:textColor="?attr/themeAccent"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnGetElevenLabsLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center"
                        android:text="ElevenLabs থেকে কী সংগ্রহ করুন (https://elevenlabs.io/) ↗"
                        android:textColor="?attr/themeAccent"
                        android:textSize="11.5sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="NUSRAT AI • Developed by MD APON"
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Bar (Next: Permission Panel) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/themeCardBg"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnNextPermission"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#10B981"
            android:text="পরবর্তী ধাপ: পারমিশন প্যানেল ➔"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSkipToHome"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:text="সরাসরি NUSRAT AI শুরু করুন"
            android:textColor="?attr/themeTextMuted"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
