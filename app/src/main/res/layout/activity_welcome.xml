<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Background Orange Glow / Gradient effect -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/circle_cyan"
        android:backgroundTint="#20FF7A00"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp" />

    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/circle_cyan"
        android:backgroundTint="#15FF7A00"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-100dp"
        android:layout_marginStart="-100dp" />

    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo Icon / Glow -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_jarvis_logo"
            android:contentDescription="Nusrat AI Logo"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NUSRAT AI"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#202020"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Intelligent AI Companion"
            android:textSize="16sp"
            android:textColor="#FF7A00"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Experience next-generation voice intelligence, secure website synchronization, and real-time AI automation."
            android:textSize="14sp"
            android:textColor="#777777"
            android:textAlignment="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Get Started (Register)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#FF7A00"
            app:cornerRadius="16dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="I Already Have an Account (Login)"
            android:textColor="#FF7A00"
            android:textSize="15sp"
            android:textStyle="bold"
            style="?attr/materialButtonOutlinedStyle"
            app:strokeColor="#FF7A00"
            app:strokeWidth="2dp"
            app:cornerRadius="16dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuest"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Continue as Guest"
                android:textColor="#202020"
                android:textSize="13sp"
                app:backgroundTint="#FFF0E3"
                app:cornerRadius="14dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActivateLicense"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Activate License"
                android:textColor="#E96500"
                android:textSize="13sp"
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="#E96500"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp"
                android:layout_marginStart="6dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
